---
import { type CollectionEntry } from "astro:content"
import Layout from "../layouts/Layout.astro"
import Navbar from "./Navbar.astro"
import TipCard from "./TipCard.astro"
import Footer from "./Footer.astro"
import { getRelativeLocaleUrl } from "astro:i18n"
import { useTranslations } from "../i18n/utils"
import ArrowLeftIcon from "../assets/icons/arrow-left.svg"
import GithubIcon from "../assets/icons/github.svg"
import XIcon from "../assets/icons/x.svg"

interface Props {
  entry: CollectionEntry<"authors">
  authorTips: CollectionEntry<"tips">[]
  totalTips: number
  alternateUrl: string
}

const { entry, authorTips, totalTips, alternateUrl } = Astro.props
const { id: authorIdField, name, bio, initials, x, github } = entry.data
const photo = `/authors/${authorIdField}.webp`

const lang = (Astro.currentLocale as "es" | "en") || "es"
const t = useTranslations(lang)
const authorBio = bio[lang] || bio[lang === "es" ? "es" : "en"]
const selfCanonical =
  lang === "es" ? `/autor/${authorIdField}/` : `/en/autor/${authorIdField}/`
---

<Layout
  title={`${name} | ${t('author.title')} | 100cosas.dev`}
  description={authorBio}
  ogType="profile"
  canonical={selfCanonical}
  alternateUrl={alternateUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: name,
    description: authorBio,
    image: `https://100cosas.dev${photo}`,
    sameAs: [x, github].filter(Boolean),
  })} />

  <Navbar total={totalTips} alternateUrl={alternateUrl} />

  <main id="main-content" tabindex="-1" class="flex-grow max-w-6xl mx-auto px-4 sm:px-6 pt-8 md:pt-12 pb-28 w-full">
    <a
      href={getRelativeLocaleUrl(lang, "/")}
      class="inline-flex items-center gap-1.5 text-[12px] text-fg-muted hover:text-fg mb-12 md:mb-16 transition-colors group"
    >
      <ArrowLeftIcon class="size-3.5 transition-transform group-hover:-translate-x-0.5" />
      {t('tip.back')}
    </a>

    <header
      class="mb-16 md:mb-20 grid gap-8 sm:grid-cols-[auto_minmax(0,1fr)] sm:items-start"
      itemscope
      itemtype="https://schema.org/Person"
    >
      <div class="size-24 md:size-28 rounded-full bg-surface-2 flex items-center justify-center text-2xl text-fg-dim overflow-hidden shrink-0">
        {
          photo ? (
            <img
              src={photo}
              alt={name}
              width="112"
              height="112"
              decoding="async"
              class="w-full h-full object-cover"
              itemprop="image"
            />
          ) : (
            initials
          )
        }
      </div>

      <div class="max-w-2xl">
        <p class="eyebrow mb-3">{t('author.title')}</p>
        <h1
          class="font-serif font-normal text-4xl md:text-6xl leading-[1.05] tracking-[-0.025em] text-fg mb-5 text-balance"
          itemprop="name"
        >
          {name}
        </h1>

        <p
          class="font-serif text-lg md:text-xl leading-relaxed text-fg-dim text-pretty"
          itemprop="description"
        >
          {authorBio}
        </p>

        {(x || github) && (
          <div class="flex items-center gap-1 mt-6 -ml-2">
            {
              x && (
                <a
                  href={x}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={lang === "es" ? `${name} en X (se abre en una pestaña nueva)` : `${name} on X (opens in a new tab)`}
                  class="text-fg-muted hover:text-fg hover:bg-surface transition-colors p-2 rounded-full"
                  itemprop="sameAs"
                >
                  <XIcon class="size-4" />
                </a>
              )
            }
            {
              github && (
                <a
                  href={github}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={lang === "es" ? `${name} en GitHub (se abre en una pestaña nueva)` : `${name} on GitHub (opens in a new tab)`}
                  class="text-fg-muted hover:text-fg hover:bg-surface transition-colors p-2 rounded-full"
                  itemprop="sameAs"
                >
                  <GithubIcon class="size-4" />
                </a>
              )
            }
          </div>
        )}
      </div>
    </header>

    <section>
      <h2 class="flex items-baseline justify-between gap-4 pb-4 border-b border-line">
        <span class="eyebrow">{t('author.tips')} {name}</span>
        <span class="text-[12px] text-fg-muted tabular-nums">{authorTips.length}</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-10">
        {authorTips.map((tip) => <TipCard {...tip.data} slug={tip.id} />)}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
