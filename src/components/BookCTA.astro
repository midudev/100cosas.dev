---
import { useTranslations } from "../i18n/utils"
import DownloadIcon from "../assets/icons/download.svg"

const lang = (Astro.currentLocale || "es") as "es" | "en"
const t = useTranslations(lang)

const pdfUrl = `/100cosas-${lang}.pdf`
const epubUrl = `/100cosas-${lang}.epub`
---

<div>
  <p class="eyebrow mb-3">{t("book.download")}</p>
  <div class="flex flex-wrap gap-2">
    <a
      href={pdfUrl}
      download
      title={t("book.format_pdf_desc")}
      class="book-btn group inline-flex items-center gap-2 rounded-full bg-fg text-bg px-4 py-2 text-[13px] font-medium hover:opacity-85 transition-opacity"
    >
      {t("book.format_pdf")}
      <DownloadIcon class="size-3.5 transition-transform group-hover:translate-y-0.5" />
    </a>
    <a
      href={epubUrl}
      download
      title={t("book.format_epub_desc")}
      class="book-btn group inline-flex items-center gap-2 rounded-full border border-line-strong text-fg px-4 py-2 text-[13px] font-medium hover:bg-surface transition-colors"
    >
      {t("book.format_epub")}
      <DownloadIcon class="size-3.5 transition-transform group-hover:translate-y-0.5" />
    </a>
  </div>
</div>
