---
import { useTranslations } from "../i18n/utils"
import FilterButton from "./FilterButton.astro"
import { getCollection } from "astro:content"
import { ui, defaultLang } from "../i18n/ui"

const lang = (Astro.currentLocale || "es") as "es" | "en"
const t = useTranslations(lang)

const tipsEntries = await getCollection("tips", ({ id }) => {
  return id.startsWith(`${lang}/`)
})

const usedCategories = new Set(tipsEntries.map((tip) => tip.data.category))

const CATEGORY_KEYS = [
  "clean_code",
  "principles",
  "architecture",
  "professionalism",
  "design",
  "testing",
  "practices",
  "soft_skills",
  "paradigm",
  "tools",
  "automation",
  "fundamentals",
  "typing",
  "ux_ui",
  "refactor",
  "ddd",
  "dry",
  "learning",
] as const

const displayedCategories = CATEGORY_KEYS.map((key) => {
  const translationKey = `cat.${key}` as keyof (typeof ui)[typeof defaultLang]
  return t(translationKey)
}).filter((name) => usedCategories.has(name)) as string[]

const otherCategories = [...usedCategories].filter(
  (name) => !displayedCategories.includes(name)
)

const allToDisplay = [...displayedCategories, ...otherCategories]
---

<div class="filter-bar relative mb-8">
  <div class="filter-scroll flex items-center gap-0.5 overflow-x-auto py-2 border-b border-white/[0.04]" id="filter-container">
    <FilterButton active filter="all">{t("filter.all")}</FilterButton>
    <span class="font-pixel text-neutral-800 select-none shrink-0">·</span>
    {
      allToDisplay.map((categoryName) => (
        <FilterButton filter={categoryName}>{categoryName}</FilterButton>
      ))
    }
  </div>
</div>

<style>
  .filter-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
    --fade-left: 0px;
    --fade-right: 0px;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 var(--fade-left),
      #000 calc(100% - var(--fade-right)),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 var(--fade-left),
      #000 calc(100% - var(--fade-right)),
      transparent 100%
    );
    transition: --fade-left 0.2s ease, --fade-right 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .filter-scroll {
      cursor: grab;
    }

    .filter-scroll.is-dragging {
      cursor: grabbing;
      user-select: none;
    }
  }

  .filter-scroll::-webkit-scrollbar {
    display: none;
  }

  /* Typed custom properties so the mask's fade width can animate
     (a bare custom property would snap instead of transitioning). */
  @property --fade-left {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }

  @property --fade-right {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }

  .filter-bar.can-scroll-left .filter-scroll {
    --fade-left: 3rem;
  }

  .filter-bar.can-scroll-right .filter-scroll {
    --fade-right: 3rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .filter-scroll {
      transition: none;
    }
  }
</style>

<script>
  function initFilterScroll() {
    const container = document.getElementById("filter-container")
    if (!(container instanceof HTMLElement)) return
    if (container.dataset.scrollEnhanced === "true") return

    container.dataset.scrollEnhanced = "true"

    const bar = container.closest(".filter-bar")

    const updateFades = () => {
      if (!(bar instanceof HTMLElement)) return
      const maxScroll = container.scrollWidth - container.clientWidth
      bar.classList.toggle("can-scroll-left", container.scrollLeft > 1)
      bar.classList.toggle(
        "can-scroll-right",
        container.scrollLeft < maxScroll - 1
      )
    }

    let isDragging = false
    let startX = 0
    let startScrollLeft = 0
    let moved = false

    container.addEventListener(
      "wheel",
      (e) => {
        if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return
        e.preventDefault()
        container.scrollLeft += e.deltaY
      },
      { passive: false }
    )

    container.addEventListener("mousedown", (e) => {
      if (e.button !== 0) return
      isDragging = true
      moved = false
      startX = e.clientX
      startScrollLeft = container.scrollLeft
      container.classList.add("is-dragging")
    })

    window.addEventListener("mousemove", (e) => {
      if (!isDragging) return

      const dx = e.clientX - startX
      if (Math.abs(dx) > 4) moved = true
      container.scrollLeft = startScrollLeft - dx
    })

    window.addEventListener("mouseup", () => {
      isDragging = false
      container.classList.remove("is-dragging")
    })

    container.addEventListener(
      "click",
      (e) => {
        if (!moved) return
        e.preventDefault()
        e.stopPropagation()
      },
      true
    )

    container.addEventListener("scroll", updateFades, { passive: true })

    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(updateFades).observe(container)
    } else {
      window.addEventListener("resize", updateFades)
    }

    // Recompute once web fonts have loaded: font swaps change text width
    // (and therefore scrollWidth) without triggering a container resize.
    if (document.fonts?.ready) {
      document.fonts.ready.then(updateFades)
    }

    updateFades()
  }

  initFilterScroll()
  document.addEventListener("astro:page-load", initFilterScroll)
</script>