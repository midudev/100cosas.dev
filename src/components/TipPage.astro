---
import { getEntry, getCollection, render, type CollectionEntry } from "astro:content"
import Layout from "../layouts/Layout.astro"
import Navbar from "./Navbar.astro"
import Footer from "./Footer.astro"
import { getRelativeLocaleUrl } from "astro:i18n"
import { useTranslations } from "../i18n/utils"
import ArrowLeftIcon from "../assets/icons/arrow-left.svg"
import CheckIcon from "../assets/icons/check.svg"
import ChevronDownIcon from "../assets/icons/chevron-down.svg"
import LinkIcon from "../assets/icons/link.svg"
import LinkedinIcon from "../assets/icons/linkedin.svg"
import XIcon from "../assets/icons/x.svg"

interface TipNavItem {
  slug: string
  title: string
}

interface Props {
  entry: CollectionEntry<"tips">
  total: number
  alternateUrl: string
  canonical?: string
  noindex?: boolean
  prev?: TipNavItem | null
  next?: TipNavItem | null
}

const { entry, total, alternateUrl, canonical, noindex = false, prev, next } = Astro.props
const { Content, headings } = await render(entry)
// Índice del consejo: solo secciones de primer nivel (##) para que quepa en el aside
const tocHeadings = headings.filter((heading) => heading.depth === 2)
const { id, title, category, author: authorId, categoryColor } = entry.data
const description = (entry.body ?? "").slice(0, 160).replace(/[#>]/g, "").trim()

const lang = (Astro.currentLocale as "es" | "en") || "es"
const t = useTranslations(lang)
const tipPath = lang === "es" ? "consejo" : "tip"
const pdfUrl = `/100cosas-${lang}.pdf`
const epubUrl = `/100cosas-${lang}.epub`

const authorEntry = await getEntry("authors", authorId)

if (!authorEntry) {
  throw new Error(`Author with id "${authorId}" not found for tip "${id}"`)
}

const {
  name: authorName,
  initials: authorInitials,
} = authorEntry.data
// Avatares de 32/40px: usar la miniatura de 64px (~4 KB) en vez de la foto completa (1200px+, 40-96 KB)
const authorPhoto = `/authors/thumbs/${authorEntry.data.id}.webp`

const allTips = await getCollection("tips", ({ id: tipId }) =>
  tipId.startsWith(`${lang}/`)
)
const authorTips = allTips
  .filter((tip) => tip.data.author === authorId && tip.data.id !== id)
  .sort((a, b) => parseInt(a.data.id) - parseInt(b.data.id))
  .slice(0, 5)

// Tiempo de lectura aproximado (sin contar bloques de código)
const proseWords = (entry.body ?? "")
  .replace(/```[\s\S]*?```/g, "")
  .split(/\s+/)
  .filter(Boolean).length
const readingMinutes = Math.max(1, Math.round(proseWords / 220))
const dotColor = categoryColor?.split(" ").find((c) => c.startsWith("text-")) ?? "text-sky-400"

const pageUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).toString()
const xShareUrl = `https://x.com/intent/post?${new URLSearchParams({
  text: `${title} — ${authorName}`,
  url: pageUrl,
  via: "midudev",
})}`
const linkedinShareUrl = `https://www.linkedin.com/sharing/share-offsite/?${new URLSearchParams({ url: pageUrl })}`
// El slug empieza por el número del consejo: "02-el-tipo-correcto..."
const nextNumber = next?.slug.split("-")[0]

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  mainEntityOfPage: pageUrl,
  image: [new URL(`/og/${entry.id}.jpg`, Astro.site).toString()],
  inLanguage: lang === "es" ? "es-ES" : "en-US",
  author: {
    "@type": "Person",
    name: authorName,
    url: `https://100cosas.dev/${lang === 'es' ? 'autor' : 'en/autor'}/${authorId}`,
  },
  publisher: {
    "@type": "Organization",
    name: "100cosas.dev",
    logo: {
      "@type": "ImageObject",
      url: "https://100cosas.dev/favicon.svg",
    },
  },
  isPartOf: {
    "@type": "WebSite",
    name: "100cosas.dev",
    url: "https://100cosas.dev",
  },
}
---

<Layout
  title={`${title} | 100cosas.dev`}
  description={description}
  ogType="article"
  image={`/og/${entry.id}.jpg`}
  canonical={canonical}
  alternateUrl={alternateUrl}
  noindex={noindex}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Navbar total={total} alternateUrl={alternateUrl} />
  <div class="reading-progress" aria-hidden="true"></div>

  <main id="main-content" tabindex="-1" class="grow max-w-6xl mx-auto px-4 sm:px-6 pt-8 md:pt-12 pb-24 w-full">
    <a
      href={getRelativeLocaleUrl(lang, "/")}
      class="inline-flex items-center gap-1.5 text-[12px] text-fg-muted hover:text-fg mb-10 md:mb-14 transition-colors group"
    >
      <ArrowLeftIcon class="size-3.5 transition-transform group-hover:-translate-x-0.5" />
      {t('tip.back')}
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_248px] gap-14 lg:gap-20 items-start">
      <!-- Article -->
      <article
        class="min-w-0 max-w-[40rem]"
        itemscope
        itemtype="https://schema.org/Article"
        data-tip-id={id}
      >
        <header class="mb-12 pb-10 border-b border-line">
          <div class="flex items-center gap-2.5 mb-6 text-[12px] text-fg-muted">
            <span class="text-accent tabular-nums" data-vt-part="number">Nº {id}</span>
            <span class="text-line-strong" aria-hidden="true">/</span>
            <span class:list={["cat-dot", dotColor]} aria-hidden="true"></span>
            <span itemprop="articleSection">{category}</span>
          </div>

          <h1
            class="font-serif text-[2.25rem] md:text-5xl lg:text-[3.4rem] font-normal text-fg leading-[1.08] tracking-[-0.022em] text-balance mb-9"
            itemprop="headline"
            data-vt-part="title"
          >
            {title}
          </h1>

          <div class="flex items-center justify-between gap-4 flex-wrap">
            <a
              href={getRelativeLocaleUrl(lang, `/autor/${authorId}`)}
              class="inline-flex items-center gap-3 group"
              itemprop="author"
              itemscope
              itemtype="https://schema.org/Person"
            >
              <div
                class="size-9 rounded-full bg-surface-2 flex items-center justify-center text-xs text-fg-dim overflow-hidden"
                data-vt-part="avatar"
              >
                {
                  authorPhoto ? (
                    <img
                      src={authorPhoto}
                      alt=""
                      width="36"
                      height="36"
                      decoding="async"
                      class="w-full h-full object-cover"
                      itemprop="image"
                    />
                  ) : (
                    authorInitials
                  )
                }
              </div>
              <span class="flex flex-col">
                <span class="eyebrow !text-[10px]">{t('tip.author')}</span>
                <span
                  class="text-[13px] text-fg group-hover:text-accent transition-colors"
                  itemprop="name"
                  data-vt-part="author"
                >
                  {authorName}
                </span>
              </span>
            </a>
            <span class="text-[12px] text-fg-muted tabular-nums">{readingMinutes} {t('tip.reading_time')}</span>
          </div>
        </header>

        <!-- Índice en móvil: en escritorio vive en el aside -->
        {tocHeadings.length >= 2 && (
          <details class="toc-mobile lg:hidden mb-12">
            <summary class="toc-mobile-summary">
              <span class="eyebrow">{t("tip.toc")}</span>
              <span class="ml-auto text-[11px] text-fg-muted tabular-nums">{tocHeadings.length} {t("tip.toc_sections")}</span>
              <ChevronDownIcon class="toc-mobile-chevron size-3.5 text-fg-muted" />
            </summary>
            <ol class="toc-mobile-list">
              {tocHeadings.map((heading, index) => (
                <li>
                  <a href={`#${heading.slug}`} class="toc-mobile-link" data-toc-link data-slug={heading.slug}>
                    <span class="text-[11px] text-fg-muted tabular-nums font-mono">{String(index + 1).padStart(2, "0")}</span>
                    <span>{heading.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )}

        <div
          class="prose prose-reading max-w-none"
          itemprop="articleBody"
          data-tip-prose
          data-anchor-label={t("tip.copy_section_link")}
          data-copied-label={t("tip.link_copied")}
        >
          <Content />
        </div>
        <!-- Iconos del enlace de cada título: el script los clona al añadir los anclas -->
        <template data-heading-anchor-icons>
          <LinkIcon class="copy-icon-link" />
          <CheckIcon class="copy-icon-check" />
        </template>
        <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>

        <!-- Prev / Next navigation -->
        {(prev || next) && (
          <nav class="mt-20 pt-8 border-t border-line grid gap-3 sm:grid-cols-2" aria-label={lang === "es" ? "Navegación entre consejos" : "Tip navigation"}>
            {prev ? (
              <a
                href={getRelativeLocaleUrl(lang, `/${tipPath}/${prev.slug}`)}
                class="tip-nav group"
              >
                <span class="eyebrow flex items-center gap-1.5">
                  <span aria-hidden="true" class="transition-transform group-hover:-translate-x-0.5">&larr;</span>
                  {t("tip.prev")}
                </span>
                <span class="font-serif text-lg leading-snug text-fg group-hover:text-accent transition-colors text-balance">{prev.title}</span>
              </a>
            ) : <span class="hidden sm:block"></span>}
            {next && (
              <a
                href={getRelativeLocaleUrl(lang, `/${tipPath}/${next.slug}`)}
                class="tip-nav group sm:text-right sm:items-end"
              >
                <span class="eyebrow flex items-center gap-1.5">
                  {t("tip.next")}
                  <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
                </span>
                <span class="font-serif text-lg leading-snug text-fg group-hover:text-accent transition-colors text-balance">{next.title}</span>
              </a>
            )}
          </nav>
        )}

        <script is:inline>
          (() => {
            const DIAGRAM_PATH = "/images/diagrams/"
            const LIGHT_DIAGRAM_PATH = "/images/diagrams/light/"

            function getDiagramSources(img) {
              const currentSrc = img.dataset.diagramDarkSrc || img.getAttribute("src") || ""
              const currentPath = currentSrc.startsWith("http")
                ? new URL(currentSrc).pathname
                : currentSrc

              if (!currentPath.includes(DIAGRAM_PATH)) return null

              const darkSrc = currentPath.includes(LIGHT_DIAGRAM_PATH)
                ? currentPath.replace(LIGHT_DIAGRAM_PATH, DIAGRAM_PATH)
                : currentPath
              const lightSrc = darkSrc.replace(DIAGRAM_PATH, LIGHT_DIAGRAM_PATH)

              img.dataset.diagramDarkSrc = darkSrc
              img.dataset.diagramLightSrc = lightSrc

              return { darkSrc, lightSrc }
            }

            function syncDiagramsToTheme() {
              const isLight = document.documentElement.dataset.theme === "light"
              document
                .querySelectorAll('article .prose img[src*="/images/diagrams/"], article .prose img[data-diagram-dark-src]')
                .forEach((img) => {
                  const sources = getDiagramSources(img)
                  if (!sources) return

                  const nextSrc = isLight ? sources.lightSrc : sources.darkSrc
                  if (img.getAttribute("src") !== nextSrc) {
                    img.setAttribute("src", nextSrc)
                  }

                  if (img.dataset.diagramFallbackBound === "true") return
                  img.dataset.diagramFallbackBound = "true"
                  img.addEventListener("error", () => {
                    const darkSrc = img.dataset.diagramDarkSrc
                    if (darkSrc && img.getAttribute("src") !== darkSrc) {
                      img.setAttribute("src", darkSrc)
                    }
                  })
                })
            }

            const observer = new MutationObserver(syncDiagramsToTheme)
            observer.observe(document.documentElement, {
              attributes: true,
              attributeFilter: ["data-theme"],
            })

            syncDiagramsToTheme()
            document.addEventListener("astro:page-load", syncDiagramsToTheme)
          })()
        </script>
      </article>

      <!-- Aside: autor arriba (se va con el scroll), índice + descargas fijos -->
      <aside class="lg:self-stretch lg:pt-2">
        <div class="space-y-10">
          <!-- Author card -->
          <div>
            <p class="eyebrow mb-4">{t('tip.author')}</p>
            <a
              href={getRelativeLocaleUrl(lang, `/autor/${authorId}`)}
              class="flex items-center gap-3 group"
            >
              <div class="size-10 rounded-full bg-surface-2 overflow-hidden shrink-0">
                {
                  authorPhoto ? (
                    <img
                      src={authorPhoto}
                      alt=""
                      width="40"
                      height="40"
                      decoding="async"
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <span class="w-full h-full flex items-center justify-center text-sm text-fg-dim">{authorInitials}</span>
                  )
                }
              </div>
              <div>
                <p class="font-serif text-[17px] leading-tight text-fg group-hover:text-accent transition-colors">{authorName}</p>
                <p class="text-[11px] text-fg-muted mt-0.5">{t('tip.view_profile')} &rarr;</p>
              </div>
            </a>
          </div>

          <!-- More by this author -->
          {authorTips.length > 0 && (
            <div>
              <p class="eyebrow mb-4">{t('tip.more_by_author')}</p>
              <ul class="space-y-3">
                {authorTips.map((tip) => {
                  const tipSlug = tip.id.replace(/^(es|en)\//, "")
                  return (
                    <li>
                      <a
                        href={getRelativeLocaleUrl(lang, `/${tipPath}/${tipSlug}`)}
                        class="flex items-baseline gap-3 group"
                      >
                        <span class="text-[11px] text-fg-muted tabular-nums shrink-0 group-hover:text-accent transition-colors">{tip.data.id}</span>
                        <span class="font-serif text-[15px] leading-snug text-fg-dim group-hover:text-fg transition-colors">{tip.data.title}</span>
                      </a>
                    </li>
                  )
                })}
              </ul>
            </div>
          )}
        </div>

        <div class="aside-sticky mt-10 space-y-10">
          <!-- Table of contents -->
          {tocHeadings.length >= 2 && (
            <nav class="hidden lg:block pt-8 border-t border-line" aria-labelledby="toc-title" data-toc>
              <p id="toc-title" class="eyebrow mb-4">{t("tip.toc")}</p>
              <div class="toc-track">
                <span class="toc-indicator" aria-hidden="true" data-toc-indicator></span>
                <ol>
                  {tocHeadings.map((heading) => (
                    <li>
                      <a href={`#${heading.slug}`} class="toc-link" data-toc-link data-slug={heading.slug}>
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            </nav>
          )}

          <!-- Siguiente consejo: aparece cuando queda poco para terminar de leer -->
          {next && (
            <div class="next-up" data-next-up inert>
              <div class="min-h-0 overflow-hidden">
                <a href={getRelativeLocaleUrl(lang, `/${tipPath}/${next.slug}`)} class="next-up-card group">
                  <span class="eyebrow flex items-center gap-1.5">
                    {t("tip.next")}
                    <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
                  </span>
                  <span class="flex items-baseline gap-3">
                    <span class="text-[11px] text-fg-muted tabular-nums shrink-0 group-hover:text-accent transition-colors">{nextNumber}</span>
                    <span class="font-serif text-[17px] leading-snug text-fg group-hover:text-accent transition-colors text-balance">{next.title}</span>
                  </span>
                </a>
              </div>
            </div>
          )}

          <!-- Share + download formats -->
          <div class="pt-8 border-t border-line">
            <div class="flex items-center justify-between gap-3 mb-6">
              <p class="eyebrow">{t("tip.share")}</p>
              <div class="flex items-center gap-1 -mr-2">
                <a href={xShareUrl} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label={t("tip.share_x")} title="X">
                  <XIcon class="size-3.5" />
                </a>
                <a href={linkedinShareUrl} target="_blank" rel="noopener noreferrer" class="share-btn" aria-label={t("tip.share_linkedin")} title="LinkedIn">
                  <LinkedinIcon class="size-3.5" />
                </a>
                <button type="button" class="share-btn" data-copy-link={pageUrl} aria-label={t("tip.copy_link")} title={t("tip.copy_link")}>
                  <LinkIcon class="copy-icon-link size-3.5" />
                  <CheckIcon class="copy-icon-check size-3.5" />
                </button>
              </div>
            </div>

            <p class="eyebrow mb-4">{t("book.download")}</p>
            <div class="flex gap-2">
              <a
                href={pdfUrl}
                download
                title={t("book.format_pdf_desc")}
                class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-full border border-line-strong px-3 py-1.5 text-[12px] text-fg hover:bg-surface transition-colors"
              >
                {t("book.format_pdf")} <span aria-hidden="true" class="text-fg-muted">&darr;</span>
              </a>
              <a
                href={epubUrl}
                download
                title={t("book.format_epub_desc")}
                class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-full border border-line-strong px-3 py-1.5 text-[12px] text-fg hover:bg-surface transition-colors"
              >
                {t("book.format_epub")} <span aria-hidden="true" class="text-fg-muted">&darr;</span>
              </a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>

<script define:vars={{ id }}>
  const STORAGE_KEY = "read-tips"
  const stored = localStorage.getItem(STORAGE_KEY)
  const readTips = stored ? JSON.parse(stored) : []
  if (!readTips.includes(id)) {
    readTips.push(id)
    localStorage.setItem(STORAGE_KEY, JSON.stringify(readTips))
  }
</script>

<script>
  import { $, $$ } from "../utils/dom"

  // Interacciones de la página de un consejo: índice con scroll-spy, "siguiente consejo",
  // enlaces a secciones y copiar enlace.
  // Con ClientRouter el módulo se ejecuta una vez; se reinicia en cada astro:page-load.
  let pageController: AbortController | undefined

  function jumpToHeading(heading: HTMLElement, hash: string) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    heading.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" })
    heading.setAttribute("tabindex", "-1")
    heading.focus({ preventScroll: true })
    history.replaceState(history.state, "", hash)
  }

  async function copyLink(url: string, trigger: HTMLElement, copiedLabel: string) {
    try {
      await navigator.clipboard.writeText(url)
    } catch {
      return
    }

    trigger.dataset.copied = ""
    const status = $("[data-copy-status]")
    if (status) status.textContent = copiedLabel
    window.setTimeout(() => {
      delete trigger.dataset.copied
      if (status) status.textContent = ""
    }, 1800)
  }

  // Botón de enlace al final de cada título (##/###). Se añade en cliente para poder
  // traducir su etiqueta; no ocupa ancho, así que no cambia cómo se parte el título.
  function addHeadingAnchors(prose: HTMLElement) {
    const label = prose.dataset.anchorLabel ?? ""
    const icons = $<HTMLTemplateElement>("[data-heading-anchor-icons]")
    $$("h2[id], h3[id]", prose).forEach((heading) => {
      if ($(".heading-anchor", heading)) return
      const anchor = document.createElement("a")
      anchor.className = "heading-anchor"
      anchor.href = `#${heading.id}`
      anchor.setAttribute("aria-label", `${label}: ${heading.textContent?.trim()}`)
      if (icons) anchor.append(icons.content.cloneNode(true))
      heading.append(anchor)
    })
  }

  // Scroll-spy del índice: resalta la sección que se está leyendo
  function createTocSpy(toc: HTMLElement | null): (force?: boolean) => void {
    if (!toc) return () => {}

    const links = $$<HTMLAnchorElement>("[data-toc-link]", toc)
    const headings = links.map((link) => document.getElementById(link.dataset.slug ?? ""))
    const track = $(".toc-track", toc)
    const indicator = $("[data-toc-indicator]", toc)
    if (headings.some((heading) => !heading)) return () => {}

    let activeIndex = -2

    return function update(force = false) {
      // Una sección está activa cuando su título cruza el primer tercio de la pantalla
      const threshold = window.innerHeight * 0.3
      let index = -1
      for (let i = 0; i < headings.length; i++) {
        if (headings[i]!.getBoundingClientRect().top > threshold) break
        index = i
      }

      // Al llegar al final de la página, la última sección cuenta como leída aunque sea corta
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2
      if (atBottom) index = headings.length - 1

      if (index === activeIndex && !force) return
      activeIndex = index

      links.forEach((link, i) => {
        if (i === index) link.setAttribute("aria-current", "location")
        else link.removeAttribute("aria-current")
        link.dataset.state = i < index ? "read" : ""
      })

      const active = links[index]
      if (indicator) {
        indicator.style.opacity = active ? "1" : "0"
        if (active) {
          indicator.style.transform = `translateY(${active.offsetTop}px)`
          indicator.style.height = `${active.offsetHeight}px`
        }
      }

      // Índice con scroll interno: mantener visible la sección activa sin mover la página
      if (active && track && track.scrollHeight > track.clientHeight) {
        const outOfView =
          active.offsetTop < track.scrollTop ||
          active.offsetTop + active.offsetHeight > track.scrollTop + track.clientHeight
        if (outOfView) track.scrollTop = active.offsetTop - track.clientHeight / 3
      }
    }
  }

  // "Siguiente consejo" en el aside: visible cuando queda menos de ~una pantalla por leer
  function createNextUp(nextUp: HTMLElement | null, prose: HTMLElement): () => boolean {
    if (!nextUp) return () => false

    return function update() {
      const visible = prose.getBoundingClientRect().bottom < window.innerHeight * 1.75
      if (visible === nextUp.hasAttribute("data-visible")) return false
      nextUp.toggleAttribute("data-visible", visible)
      nextUp.inert = !visible
      return true
    }
  }

  function initTipPage() {
    pageController?.abort()

    const main = $("#main-content")
    const prose = $("[data-tip-prose]")
    if (!main || !prose) return

    pageController = new AbortController()
    const { signal } = pageController
    const copiedLabel = prose.dataset.copiedLabel ?? ""

    addHeadingAnchors(prose)
    const updateToc = createTocSpy($("[data-toc]"))
    const updateNextUp = createNextUp($("[data-next-up]"), prose)

    let frame = 0
    function update(force = false) {
      frame = 0
      // Si aparece "siguiente consejo" el índice encoge: recolocar la sección activa
      const nextUpChanged = updateNextUp()
      updateToc(force || nextUpChanged)
    }

    function schedule() {
      if (!frame) frame = requestAnimationFrame(() => update())
    }

    window.addEventListener("scroll", schedule, { passive: true, signal })
    window.addEventListener("resize", () => update(true), { passive: true, signal })

    // Escuchar en <main> y no en document: así se ejecuta antes que ClientRouter,
    // que trataría los enlaces #seccion como una navegación
    main.addEventListener(
      "click",
      (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
        const target = event.target as Element | null

        const copyButton = target?.closest<HTMLElement>("[data-copy-link]")
        if (copyButton) {
          copyLink(copyButton.dataset.copyLink ?? location.href, copyButton, copiedLabel)
          return
        }

        const anchor = target?.closest<HTMLAnchorElement>(".heading-anchor")
        if (anchor) {
          event.preventDefault()
          jumpToHeading(anchor.parentElement as HTMLElement, anchor.hash)
          copyLink(anchor.href, anchor, copiedLabel)
          return
        }

        const tocLink = target?.closest<HTMLAnchorElement>("[data-toc-link]")
        const heading = tocLink && document.getElementById(tocLink.dataset.slug ?? "")
        if (!tocLink || !heading) return

        event.preventDefault()
        // Cerrar primero el índice móvil: si no, al plegarse desplazaría el destino
        const details = tocLink.closest("details")
        if (details) details.open = false
        jumpToHeading(heading, tocLink.hash)
      },
      { signal }
    )

    update(true)
  }

  document.addEventListener("astro:page-load", initTipPage)
</script>

