---
import { useTranslations } from "../i18n/utils"
import { getRelativeLocaleUrl } from "astro:i18n"
import { routes } from "../i18n/ui"
import ArrowUpRightIcon from "../assets/icons/arrow-up-right.svg"
import CloseIcon from "../assets/icons/close.svg"
import MoonIcon from "../assets/icons/moon.svg"
import SearchIcon from "../assets/icons/search.svg"
import SunIcon from "../assets/icons/sun.svg"

interface Props {
  total?: number
  alternateUrl?: string
  showSearch?: boolean
}

const { total = 100, alternateUrl, showSearch = false } = Astro.props

const lang = (Astro.currentLocale || "es") as "es" | "en"
const t = useTranslations(lang)

const aboutPath = routes[lang].about
const themeLabel = t("nav.theme")
const themeLightLabel = t("nav.theme_light")
const themeDarkLabel = t("nav.theme_dark")
const switchToLightLabel = t("nav.theme_switch_to_light")
const switchToDarkLabel = t("nav.theme_switch_to_dark")
---

<nav
  id="navbar"
  aria-label={lang === "es" ? "Navegación principal" : "Main navigation"}
  data-total={total}
  data-theme-light={themeLightLabel}
  data-theme-dark={themeDarkLabel}
  data-switch-to-light={switchToLightLabel}
  data-switch-to-dark={switchToDarkLabel}
  class="navbar sticky top-0 z-50 border-b border-line"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center h-14 gap-4">

      <a
        href={getRelativeLocaleUrl(lang, "/")}
        class="navbar-logo group flex items-baseline gap-1 shrink-0"
      >
        <span class="font-pixel text-[19px] text-accent leading-none">100</span>
        <span class="text-[13px] text-fg-dim group-hover:text-fg transition-colors leading-none">cosas.dev</span>
      </a>

      {showSearch && (
        <div class="navbar-search hidden md:flex items-center flex-1 max-w-sm mx-auto">
          <label for="tips-search" class="sr-only">{t("nav.search")}</label>
          <div class="search-field relative w-full">
            <SearchIcon class="search-field-icon pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 size-3.5 text-fg-muted" />
            <input
              id="tips-search"
              type="search"
              inputmode="search"
              autocomplete="off"
              spellcheck="false"
              aria-keyshortcuts="/"
              aria-describedby="tips-search-hint tips-search-status"
              placeholder={t("nav.search_placeholder")}
              class="navbar-search-input w-full rounded-full border border-line bg-surface pl-9 pr-10 py-1.5 text-[12px] text-fg placeholder:text-fg-muted hover:border-line-strong focus:border-accent/50 transition-colors"
            />
            <kbd class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 rounded border border-line px-1.5 py-0.5 text-[10px] leading-none text-fg-muted font-mono">/</kbd>
            <button
              type="button"
              data-search-clear
              aria-label={t("search.clear")}
              class="search-field-clear absolute right-1.5 top-1/2 -translate-y-1/2 inline-flex items-center justify-center size-6 rounded-full text-fg-muted hover:text-fg hover:bg-surface-2 transition-colors"
            >
              <CloseIcon class="size-3" />
            </button>
          </div>
          <span id="tips-search-hint" class="sr-only">{t("nav.search_shortcut")}</span>
          <span
            id="tips-search-status"
            data-results-label={t("nav.search_results")}
            class="sr-only"
            role="status"
            aria-live="polite"
            aria-atomic="true"
          ></span>
        </div>
      )}

      <div class="hidden md:flex items-center gap-1 shrink-0 ml-auto">
        <div class="navbar-progress flex items-center gap-2.5 px-2">
          <div class="w-16 h-[2px] bg-line rounded-full overflow-hidden">
            <div
              id="progress-bar"
              class="h-full bg-accent rounded-full w-[0%]"
              style="transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);"
            >
            </div>
          </div>
          <span
            id="progress-text"
            role="status"
            aria-live="polite"
            aria-atomic="true"
            class="text-[11px] text-fg-muted tabular-nums whitespace-nowrap"
            data-text-read={t("nav.read")}>0/{total} {t("nav.read")}</span
          >
        </div>

        <div class="navbar-separator"></div>

        <button
          type="button"
          data-theme-toggle
          aria-label={switchToLightLabel}
          class="theme-toggle inline-flex items-center gap-2 text-[12px] text-fg-dim hover:text-fg transition-colors px-2.5 py-1.5 rounded-full hover:bg-surface"
        >
          <span class="theme-toggle-icon" aria-hidden="true">
            <MoonIcon class="theme-icon theme-icon-moon size-3.5" />
            <SunIcon class="theme-icon theme-icon-sun size-3.5" />
          </span>
          <span class="theme-toggle-label hidden xl:inline" data-theme-label>{themeLabel}</span>
        </button>

        <div class="flex items-center">
          <a
            href={getRelativeLocaleUrl(lang, `/${aboutPath}`)}
            class="navbar-link text-[12px] text-fg-dim hover:text-fg transition-colors px-2.5 py-1.5 rounded-full hover:bg-surface"
          >
            {t("nav.about")}
          </a>
          <a
            href="https://github.com/midudev/100cosas.dev"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={lang === "es" ? "GitHub (se abre en una pestaña nueva)" : "GitHub (opens in a new tab)"}
            class="navbar-link text-[12px] text-fg-dim hover:text-fg transition-colors px-2.5 py-1.5 rounded-full hover:bg-surface flex items-center gap-1"
          >
            GitHub
            <ArrowUpRightIcon class="size-3 opacity-40" />
          </a>
        </div>

      </div>

      <!-- Mobile -->
      <div class="flex md:hidden items-center gap-3 ml-auto">
        {showSearch && (
          <button
            type="button"
            id="mobile-search-toggle"
            aria-label={t("nav.search")}
            class="text-fg-dim hover:text-fg transition-colors p-1.5"
          >
            <SearchIcon class="size-4" />
          </button>
        )}

        <button
          type="button"
          data-theme-toggle
          aria-label={switchToLightLabel}
          class="theme-toggle-mobile text-fg-dim hover:text-fg transition-colors p-1.5 rounded-full hover:bg-surface"
        >
          <span class="theme-toggle-icon" aria-hidden="true">
            <MoonIcon class="theme-icon theme-icon-moon size-4" />
            <SunIcon class="theme-icon theme-icon-sun size-4" />
          </span>
        </button>

        <div class="flex items-center gap-2">
          <span
            id="progress-text-mobile"
            role="status"
            aria-live="polite"
            aria-atomic="true"
            class="text-[11px] text-fg-muted tabular-nums leading-none">0/{total}</span
          >
          <div class="w-12 h-[2px] bg-line rounded-full overflow-hidden">
            <div
              id="progress-bar-mobile"
              class="h-full bg-accent rounded-full w-[0%]"
              style="transition: width 0.5s ease;"
            >
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>

  {showSearch && (
    <div
      id="mobile-search-bar"
      class="md:hidden overflow-hidden transition-all duration-200 ease-out"
      style="max-height: 0;"
    >
      <div class="px-4 pb-3 pt-1">
        <label for="tips-search-mobile" class="sr-only">{t("nav.search")}</label>
        <div class="search-field relative">
          <SearchIcon class="search-field-icon pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 size-3.5 text-fg-muted" />
          <input
            id="tips-search-mobile"
            type="search"
            inputmode="search"
            autocomplete="off"
            spellcheck="false"
            placeholder={t("nav.search_placeholder")}
            class="navbar-search-input w-full rounded-full border border-line bg-surface pl-9 pr-10 py-2 text-[13px] text-fg placeholder:text-fg-muted focus:border-accent/50 transition-colors"
          />
          <button
            type="button"
            data-search-clear
            aria-label={t("search.clear")}
            class="search-field-clear absolute right-1.5 top-1/2 -translate-y-1/2 inline-flex items-center justify-center size-7 rounded-full text-fg-muted hover:text-fg hover:bg-surface-2 transition-colors"
          >
            <CloseIcon class="size-3" />
          </button>
        </div>
      </div>
    </div>
  )}
</nav>

<style>
  .navbar {
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    background: var(--navbar-bg);
  }

  @media (max-width: 767px) {
    .navbar {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  .navbar-separator {
    width: 1px;
    height: 16px;
    background: var(--navbar-separator);
    margin: 0 4px;
    flex-shrink: 0;
  }

  .theme-toggle-icon {
    position: relative;
    width: 0.95rem;
    height: 0.95rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .theme-icon {
    position: absolute;
    transition: opacity 140ms ease, transform 140ms ease;
  }

  :root[data-theme="dark"] .theme-icon-sun,
  :root[data-theme="light"] .theme-icon-moon {
    opacity: 0;
    transform: scale(0.8) rotate(-12deg);
  }

  :root[data-theme="dark"] .theme-icon-moon,
  :root[data-theme="light"] .theme-icon-sun {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  .navbar-search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  /* Con texto en el buscador: se resalta y el atajo "/" deja paso al botón de limpiar */
  .navbar-search-input:not(:placeholder-shown) {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .search-field:has(.navbar-search-input:not(:placeholder-shown)) .search-field-icon {
    color: var(--accent);
  }

  .search-field:has(.navbar-search-input:not(:placeholder-shown)) kbd,
  .search-field:has(.navbar-search-input:placeholder-shown) .search-field-clear {
    display: none;
  }
</style>

<script>
  import { $, $$ } from "../utils/dom"

  const READ_STORAGE_KEY = "read-tips"
  const THEME_STORAGE_KEY = "site-theme"
  const DARK_THEME_COLOR = "#0e0e0f"
  const LIGHT_THEME_COLOR = "#fbfaf6"

  function getReadTips() {
    try {
      const stored = localStorage.getItem(READ_STORAGE_KEY)
      if (!stored) return []
      const parsed = JSON.parse(stored)
      return Array.isArray(parsed) ? parsed : []
    } catch (e) {
      console.error("Error parsing read tips from localStorage", e)
      return []
    }
  }

  function saveReadTip(id: string, isRead: boolean) {
    try {
      const readTips = getReadTips()
      const newReadTips = isRead
        ? [...new Set([...readTips, id])]
        : readTips.filter((tipId: string) => tipId !== id)
      localStorage.setItem(READ_STORAGE_KEY, JSON.stringify(newReadTips))
      updateProgress()
    } catch (e) {
      console.error("Error saving read tip to localStorage", e)
    }
  }

  function updateProgress() {
    const navbar = $("#navbar")
    const total = parseInt(navbar?.dataset.total || "100")
    const readTips = getReadTips()
    const count = readTips.length
    const percentage = Math.round((count / total) * 100)

    $$("#progress-bar, #progress-bar-mobile").forEach((bar) => {
      bar.style.width = `${percentage}%`
    })

    $$("#progress-text, #progress-text-mobile").forEach((text) => {
      const isMobile = text.id.includes("mobile")
      const readText = text.dataset.textRead || "leídos"
      text.textContent = isMobile
        ? `${count}/${total}`
        : `${count}/${total} ${readText}`
    })
  }

  function handleCheckboxChange(e: Event) {
    const target = e.target as HTMLInputElement
    if (target && target.classList.contains("read-toggle")) {
      const id = target.getAttribute("data-id")
      const isChecked = target.checked
      if (id) saveReadTip(id, isChecked)
    }
  }

  function getThemeFromStorage() {
    try {
      const storedTheme = localStorage.getItem(THEME_STORAGE_KEY)
      return storedTheme === "light" || storedTheme === "dark"
        ? storedTheme
        : null
    } catch {
      return null
    }
  }

  function getCurrentTheme() {
    return document.documentElement.dataset.theme === "light" ? "light" : "dark"
  }

  function setTheme(theme: "light" | "dark", save = false) {
    const root = document.documentElement
    root.dataset.theme = theme
    root.style.colorScheme = theme

    const navbar = $("#navbar")
    const themeLabel = theme === "light"
      ? navbar?.dataset.themeLight || "Light"
      : navbar?.dataset.themeDark || "Dark"
    const switchLabel = theme === "light"
      ? navbar?.dataset.switchToDark || "Switch to dark mode"
      : navbar?.dataset.switchToLight || "Switch to light mode"

    const themeColorMeta = $("#theme-color-meta")
    if (themeColorMeta) {
      themeColorMeta.setAttribute(
        "content",
        theme === "light" ? LIGHT_THEME_COLOR : DARK_THEME_COLOR
      )
    }

    $$("[data-theme-label]").forEach((label) => {
      label.textContent = themeLabel
    })

    $$("[data-theme-toggle]").forEach((button) => {
      button.setAttribute("aria-label", switchLabel)
    })

    if (save) {
      try {
        localStorage.setItem(THEME_STORAGE_KEY, theme)
      } catch {
        // ignore write errors
      }
    }
  }

  // Evita que elementos con transition-colors (p. ej. el buscador) cambien
  // de color más tarde que el resto de la página al alternar el tema
  function withoutColorTransitions(callback: () => void) {
    const root = document.documentElement
    root.dataset.themeSwitching = ""
    callback()
    void document.body.offsetHeight
    requestAnimationFrame(() => {
      delete root.dataset.themeSwitching
    })
  }

  function initThemeToggle() {
    $$<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      if (button.dataset.themeBound === "true") return
      button.dataset.themeBound = "true"

      button.addEventListener("click", () => {
        const nextTheme = getCurrentTheme() === "dark" ? "light" : "dark"
        withoutColorTransitions(() => setTheme(nextTheme, true))
      })
    })

    const storedTheme = getThemeFromStorage()
    if (storedTheme) {
      setTheme(storedTheme)
    } else {
      setTheme(getCurrentTheme())
    }
  }

  function initMobileSearch() {
    const toggle = $("#mobile-search-toggle")
    const bar = $("#mobile-search-bar")
    const desktopInput = $<HTMLInputElement>("#tips-search")
    const mobileInput = $<HTMLInputElement>("#tips-search-mobile")

    if (toggle && bar) {
      if (toggle.dataset.searchBound !== "true") {
        toggle.dataset.searchBound = "true"
        toggle.addEventListener("click", () => {
          const isOpen = bar.style.maxHeight !== "0px" && bar.style.maxHeight !== ""
          if (isOpen) {
            bar.style.maxHeight = "0px"
          } else {
            bar.style.maxHeight = "60px"
            mobileInput?.focus()
          }
        })
      }
    }

    if (desktopInput && mobileInput) {
      if (desktopInput.dataset.syncBound !== "true") {
        desktopInput.dataset.syncBound = "true"
        desktopInput.addEventListener("input", () => {
          mobileInput.value = desktopInput.value
        })
      }

      if (mobileInput.dataset.syncBound !== "true") {
        mobileInput.dataset.syncBound = "true"
        mobileInput.addEventListener("input", () => {
          desktopInput.value = mobileInput.value
          desktopInput.dispatchEvent(new Event("input", { bubbles: true }))
        })
      }
    }
  }

  function init() {
    const readTips = getReadTips()

    $$<HTMLInputElement>(".read-toggle").forEach((checkbox) => {
      checkbox.checked = readTips.includes(checkbox.getAttribute("data-id"))
    })

    updateProgress()
    initThemeToggle()
    initMobileSearch()
  }

  document.addEventListener("change", handleCheckboxChange)

  init()
  document.addEventListener("astro:page-load", init)
</script>
