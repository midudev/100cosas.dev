---
import Layout from "../layouts/Layout.astro"
import Navbar from "./Navbar.astro"
import PixelBackdrop from "./PixelBackdrop.astro"
import Hero from "./Hero.astro"
import FilterBar from "./FilterBar.astro"
import TipCard from "./TipCard.astro"
import Footer from "./Footer.astro"
import { type CollectionEntry } from "astro:content"
import { useTranslations } from "../i18n/utils"
import CloseIcon from "../assets/icons/close.svg"

interface Props {
  sortedTips: CollectionEntry<"tips">[]
  canonical?: string
  alternateUrl?: string
  noindex?: boolean
}

const { sortedTips, canonical, alternateUrl, noindex = false } = Astro.props
const lang = (Astro.currentLocale as "es" | "en") || "es"
const t = useTranslations(lang)
const searchIndexUrl = lang === "es" ? "/search-index.json" : "/en/search-index.json"
const pageTitle = `${t("hero.title")} ${t("hero.subtitle")}`
const pageDescription = t("hero.description")
const authorsCount = new Set(sortedTips.map((tip) => tip.data.author)).size

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  url: new URL(canonical ?? Astro.url.pathname, Astro.site).toString(),
  inLanguage: lang === "es" ? "es-ES" : "en-US",
  isPartOf: {
    "@type": "WebSite",
    name: "100cosas.dev",
    url: Astro.site?.toString(),
  },
}

const allTips = Array.from({ length: 100 }, (_, i) => {
  const tipId = (i + 1).toString().padStart(2, "0")
  const existingTip = sortedTips.find((tip) => tip.data.id === tipId)

  if (existingTip) {
    return {
      ...existingTip.data,
      slug: existingTip.id,
      content: existingTip.body ?? "",
      isPlaceholder: false,
    }
  }

  return {
    id: tipId,
    title: t("tip.upcoming"),
    category: "???",
    author: "midudev",
    content: "",
    isPlaceholder: true,
  }
})
---

<Layout
  title={`${pageTitle} | 100cosas.dev`}
  description={pageDescription}
  canonical={canonical}
  alternateUrl={alternateUrl}
  noindex={noindex}
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />

  <PixelBackdrop />
  <Navbar total={sortedTips.length} showSearch alternateUrl={alternateUrl} />

  <main
    id="main-content"
    tabindex="-1"
    class="flex-grow max-w-6xl mx-auto px-4 sm:px-6 pb-28 w-full"
    data-search-index-url={searchIndexUrl}
  >
    <Hero tipsCount={sortedTips.length} authorsCount={authorsCount} />

    <h2 class="sr-only">{t("index.title")}</h2>
    <FilterBar />

    <div
      id="search-summary"
      class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 pt-5 pb-1"
      data-label-one={t("search.results_one")}
      data-label-other={t("search.results_other")}
      hidden
    >
      <p class="min-w-0 text-[13px] leading-snug text-fg-dim">
        <span class="font-serif text-[1.75rem] leading-none text-fg tabular-nums mr-1" data-search-count>0</span>
        <span data-search-label></span>
        <q class="search-query text-accent" data-search-query></q>
        <span data-search-category-wrap hidden>
          {t("search.in_category")} <span class="text-fg" data-search-category></span>
        </span>
      </p>
      <button
        type="button"
        data-search-clear
        class="inline-flex items-center gap-1.5 text-[12px] text-fg-dim hover:text-fg transition-colors px-2.5 py-1.5 rounded-full hover:bg-surface"
      >
        <CloseIcon class="size-3" />
        {t("search.clear")}
      </button>
    </div>

    <div
      id="tips-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-10"
    >
      {allTips.map((tip) => <TipCard {...tip} />)}
    </div>

    <div id="search-empty" class="py-20 text-center" hidden>
      <p class="font-serif text-2xl text-fg text-balance">{t("search.empty_title")}</p>
      <p class="mt-2 text-[13px] text-fg-muted">{t("search.empty_hint")}</p>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .search-query {
    quotes: "«" "»";
    overflow-wrap: anywhere;
  }

  .search-query:lang(en) {
    quotes: "\201C" "\201D";
  }
</style>

<script>
  import { $, $$ } from "../utils/dom"

  type SearchRecord = {
    id: string
    text: string
  }

  type SearchState = {
    index: Map<string, string> | null
    indexPromise: Promise<Map<string, string>> | null
  }

  const searchState = ((globalThis as typeof globalThis & {
    __tipsSearchState?: SearchState
  }).__tipsSearchState ??= {
    index: null,
    indexPromise: null,
  })

  const normalizeSearch = (value: string) =>
    value
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^\p{Letter}\p{Number}\s#-]/gu, " ")
      .replace(/\s+/g, " ")
      .trim()

  async function loadSearchIndex() {
    if (searchState.index) return searchState.index

    if (!searchState.indexPromise) {
      const main = $("#main-content")
      const searchIndexUrl = main?.dataset.searchIndexUrl

      if (!searchIndexUrl) return new Map<string, string>()

      searchState.indexPromise = fetch(searchIndexUrl, {
        headers: {
          accept: "application/json",
        },
      })
        .then((response) => {
          if (!response.ok) throw new Error("Search index request failed")
          return response.json() as Promise<{ records: SearchRecord[] }>
        })
        .then(({ records }) => {
          const index = new Map(records.map((record) => [record.id, record.text]))
          searchState.index = index
          return index
        })
        .catch(() => {
          const fallback = new Map<string, string>()
          searchState.index = fallback
          return fallback
        })
    }

    return searchState.indexPromise
  }

  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches

  // Al buscar desde la navbar con el hero en pantalla, la rejilla queda fuera de la vista
  // y no se aprecia el filtrado: desplaza la página hasta el resumen de resultados
  function revealResults(target: HTMLElement) {
    const navbarBottom = $("#navbar")?.getBoundingClientRect().bottom ?? 0
    const viewportHeight = window.visualViewport?.height ?? window.innerHeight
    const { top } = target.getBoundingClientRect()
    if (top >= navbarBottom && top <= viewportHeight / 2) return

    window.scrollTo({
      top: window.scrollY + top - navbarBottom - 16,
      behavior: prefersReducedMotion() ? "auto" : "smooth",
    })
  }

  function initSearch() {
    const searchInput = $<HTMLInputElement>("#tips-search")
    const searchStatus = $("#tips-search-status")
    const searchSummary = $("#search-summary")
    const searchEmpty = $("#search-empty")
    const filterContainer = $("#filter-container")
    const tipCards = $$(".tip-card")

    if (!searchInput) return

    const summaryCount = searchSummary && $("[data-search-count]", searchSummary)
    const summaryLabel = searchSummary && $("[data-search-label]", searchSummary)
    const summaryQuery = searchSummary && $("[data-search-query]", searchSummary)
    const summaryCategoryWrap = searchSummary && $("[data-search-category-wrap]", searchSummary)
    const summaryCategory = searchSummary && $("[data-search-category]", searchSummary)

    const applyFilters = () => {
      const activeButton = $('.filter-btn[data-active="true"]')
      const activeFilter = activeButton?.dataset.filter || "all"
      const query = normalizeSearch(searchInput.value || "")
      const isSearching = query.length > 0
      let visibleCount = 0

      tipCards.forEach((el) => {
        const category = el.dataset.category || ""
        const indexedSearch = el.dataset.id ? searchState.index?.get(el.dataset.id) : ""
        const searchable = indexedSearch || el.dataset.search || ""
        const matchesCategory = activeFilter === "all" || category === activeFilter
        // Los huecos "Próximamente" no son resultados: se ocultan mientras se busca
        const isPlaceholder = el.classList.contains("is-placeholder")
        const matchesSearch = !isSearching || (!isPlaceholder && searchable.includes(query))
        const isVisible = matchesCategory && matchesSearch

        el.style.display = isVisible ? "block" : "none"
        if (isVisible) visibleCount += 1
      })

      if (searchSummary) {
        searchSummary.hidden = !isSearching

        if (isSearching) {
          const { labelOne = "", labelOther = "" } = searchSummary.dataset
          if (summaryCount) summaryCount.textContent = String(visibleCount)
          if (summaryLabel) summaryLabel.textContent = visibleCount === 1 ? labelOne : labelOther
          if (summaryQuery) summaryQuery.textContent = searchInput.value.trim()
          if (summaryCategory) summaryCategory.textContent = activeFilter
          if (summaryCategoryWrap) summaryCategoryWrap.hidden = activeFilter === "all"
        }
      }

      if (searchEmpty) searchEmpty.hidden = !isSearching || visibleCount > 0

      if (searchStatus) {
        const label = searchStatus.dataset.resultsLabel || "resultados encontrados"
        searchStatus.textContent = isSearching ? `${visibleCount} ${label}` : ""
      }
    }

    if (filterContainer && filterContainer.dataset.filterBound !== "true") {
      filterContainer.dataset.filterBound = "true"
      filterContainer.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement | null)?.closest(".filter-btn")
        if (!button) return

        $$(".filter-btn", filterContainer).forEach((btn) => {
          btn.setAttribute("data-active", "false")
          btn.setAttribute("aria-pressed", "false")
        })

        button.setAttribute("data-active", "true")
        button.setAttribute("aria-pressed", "true")
        applyFilters()
      })
    }

    if (searchInput.dataset.searchBound !== "true") {
      searchInput.dataset.searchBound = "true"
      searchInput.addEventListener("input", () => {
        const query = searchInput.value.trim()
        applyFilters()

        if (searchSummary && !searchSummary.hidden) revealResults(searchSummary)

        if (query.length > 0 && !searchState.index) {
          void loadSearchIndex().then(applyFilters)
        }
      })
    }
  }

  function handleSearchClear(event: MouseEvent) {
    const button = (event.target as HTMLElement | null)?.closest("[data-search-clear]")
    if (!button) return

    const desktopInput = $<HTMLInputElement>("#tips-search")
    const mobileInput = $<HTMLInputElement>("#tips-search-mobile")
    if (!desktopInput) return

    // El input de escritorio propaga el valor al de móvil (ver Navbar)
    desktopInput.value = ""
    desktopInput.dispatchEvent(new Event("input", { bubbles: true }))

    // El botón pulsado se oculta: devuelve el foco al buscador visible
    const mobileBar = $("#mobile-search-bar")
    const isMobileBarOpen = !!mobileBar && !["", "0px"].includes(mobileBar.style.maxHeight)
    const input = desktopInput.offsetParent ? desktopInput : isMobileBarOpen ? mobileInput : null
    input?.focus({ preventScroll: true })
  }

  function handleSearchKeydown(event: KeyboardEvent) {
    const target = event.target as HTMLElement | null
    const tagName = target?.tagName?.toLowerCase()
    const isEditable =
      tagName === "input" ||
      tagName === "textarea" ||
      target?.isContentEditable

    if (event.key === "/" && !isEditable) {
      const searchInput = $<HTMLInputElement>("#tips-search")
      if (searchInput) {
        event.preventDefault()
        searchInput.focus()
        searchInput.select()
      }
    }
  }

  if (document.documentElement.dataset.searchShortcutBound !== "true") {
    document.documentElement.dataset.searchShortcutBound = "true"
    document.addEventListener("keydown", handleSearchKeydown)
    document.addEventListener("click", handleSearchClear)
  }

  initSearch()
  document.addEventListener("astro:page-load", initSearch)
</script>
