---
import { getEntry } from "astro:content"
import { getRelativeLocaleUrl } from "astro:i18n"
import { useTranslations } from "../i18n/utils"
import { normalizeSearchText } from "../utils/search"
import ArrowRightIcon from "../assets/icons/arrow-right.svg"
import EyeIcon from "../assets/icons/eye.svg"
import EyeCheckIcon from "../assets/icons/eye-check.svg"

interface Props {
  id: string
  title: string
  category: string
  categoryColor?: string
  author: string
  content?: string
  checked?: boolean
  slug?: string
  isPlaceholder?: boolean
}

const {
  id,
  title,
  category,
  categoryColor = "text-sky-400",
  author: authorId,
  checked = false,
  slug = "#",
  isPlaceholder = false,
} = Astro.props

const lang = (Astro.currentLocale || "es") as "es" | "en"
const t = useTranslations(lang)
const tipLinkLabel =
  lang === "es"
    ? `Leer consejo ${id}: ${title}`
    : `Read tip ${id}: ${title}`
const readToggleLabel =
  lang === "es"
    ? `Marcar consejo ${id} como leído`
    : `Mark tip ${id} as read`

// Solo el color de texto: se usa como `currentColor` del punto de categoría
const dotColor = categoryColor.split(" ").find((c) => c.startsWith("text-")) ?? "text-sky-400"

let authorName = "Autor"
let authorPhoto = ""
let initials = "?"

if (!isPlaceholder) {
  const authorEntry = await getEntry("authors", authorId)

  if (!authorEntry) {
    throw new Error(`Author with id "${authorId}" not found for tip "${id}"`)
  }

  authorName = authorEntry.data.name
  initials = authorEntry.data.initials
  authorPhoto = `/authors/thumbs/${authorEntry.data.id}.webp`
}

const slugWithoutLang = slug.replace(/^(es|en)\//, "")
const tipPath = lang === "es" ? "consejo" : "tip"
const searchableText = normalizeSearchText(`${id} ${title} ${authorName} ${category}`)
---

{
  isPlaceholder ? (
    <div class="tip-card is-placeholder" data-id={id} data-category={category} data-search={searchableText} aria-hidden="true">
      <div class="tc-link">
        <span class="tc-num">{id}</span>
        <span class="tc-soon">{t("tip.upcoming")}</span>
      </div>
    </div>
  ) : (
    <div
      class="tip-card group"
      data-id={id}
      data-category={category}
      data-search={searchableText}
      itemscope
      itemtype="https://schema.org/Article"
    >
      <a
        href={getRelativeLocaleUrl(lang, `/${tipPath}/${slugWithoutLang}`)}
        class="tc-link"
        aria-label={tipLinkLabel}
        itemprop="url"
      >
        <div class="tc-meta">
          <span class="tc-num" data-vt-part="number">{id}</span>
          <span class:list={["cat-dot", dotColor]} aria-hidden="true" />
          <span itemprop="articleSection">{category}</span>
        </div>

        <h3 class="tc-title font-serif" itemprop="headline" data-vt-part="title">
          {title}
        </h3>

        <div class="tc-author" itemprop="author" itemscope itemtype="https://schema.org/Person">
          <div class="tc-avatar" data-vt-part="avatar">
            <img
              src={authorPhoto}
              alt=""
              width="20"
              height="20"
              loading="lazy"
              decoding="async"
              itemprop="image"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
            />
            <span>{initials}</span>
          </div>
          <span itemprop="name" data-vt-part="author">{authorName}</span>
          <ArrowRightIcon class="tc-arrow" />
        </div>
      </a>

      <label
        class="tc-read"
        data-tooltip-pending={lang === "es" ? "Marcar como leído" : "Mark as read"}
        data-tooltip-read={lang === "es" ? "Leído" : "Read"}
      >
        <input
          type="checkbox"
          class="read-toggle sr-only"
          checked={checked}
          data-id={id}
          aria-label={readToggleLabel}
        />
        <span class="tip-tooltip">{lang === "es" ? "Marcar como leído" : "Mark as read"}</span>
        <EyeIcon class="eye-off" />
        <EyeCheckIcon class="eye-on" />
      </label>
    </div>
  )
}

<style>
  .tip-card {
    border-bottom: 1px solid var(--border);
  }

  .tc-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 9.5rem;
    padding: 1.375rem 0 1.25rem;
    border-radius: 2px;
  }

  .tc-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding-right: 2rem;
    font-size: 11px;
    line-height: 1rem;
    color: var(--text-muted);
  }

  .tc-num {
    font-variant-numeric: tabular-nums;
    color: var(--text-dim);
    margin-right: 0.25rem;
    transition: color 150ms ease;
  }

  .tc-title {
    font-size: 1.3125rem;
    line-height: 1.3;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--text);
    text-wrap: balance;
    transition: color 150ms ease;
  }

  .tc-author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: 11px;
    color: var(--text-muted);
  }

  .tc-avatar {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--surface-2);
  }

  .tc-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 200ms ease;
  }

  .tc-avatar span {
    display: none;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    font-size: 8px;
  }

  .tc-arrow {
    width: 14px;
    height: 14px;
    margin-left: auto;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 150ms ease, transform 200ms ease;
  }

  .tip-card:hover .tc-num,
  .tip-card:focus-within .tc-num {
    color: var(--accent);
  }

  .tip-card:hover .tc-avatar img,
  .tip-card:focus-within .tc-avatar img {
    filter: none;
  }

  .tip-card:hover .tc-arrow,
  .tip-card:focus-within .tc-arrow {
    opacity: 1;
    transform: none;
  }

  /* Consejos leídos: se atenúan como un enlace visitado */
  .tip-card:has(.read-toggle:checked) .tc-title {
    color: var(--text-muted);
  }

  .is-placeholder .tc-link {
    min-height: 9.5rem;
    color: var(--text-muted);
    opacity: 0.55;
  }

  .is-placeholder .tc-num {
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .tc-soon {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.125rem;
  }

  .tc-read {
    position: absolute;
    top: 1.125rem;
    right: 0;
    z-index: 1;
    padding: 0.25rem;
    cursor: pointer;
    color: var(--text-muted);
    transition: color 150ms ease;
  }

  .tc-read:hover {
    color: var(--text);
  }

  .tc-read:has(:checked) {
    color: var(--success);
  }

  .tc-read:has(:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .tc-read svg {
    display: block;
    width: 15px;
    height: 15px;
  }

  .tc-read .eye-on,
  .tc-read:has(:checked) .eye-off {
    display: none;
  }

  .tc-read:has(:checked) .eye-on {
    display: block;
  }

  .tip-tooltip {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    white-space: nowrap;
    font-size: 10px;
    letter-spacing: 0.02em;
    color: var(--text-dim);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 8px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .tc-read:hover .tip-tooltip {
    opacity: 1;
  }
</style>

<script>
  import { $, $$ } from "../utils/dom"

  $$(".tip-card label[data-tooltip-pending]").forEach((label) => {
    const tooltip = $(".tip-tooltip", label)
    const input = $("input", label)
    if (!tooltip || !input) return

    const pending = label.getAttribute("data-tooltip-pending") || ""
    const read = label.getAttribute("data-tooltip-read") || ""

    function update() {
      tooltip!.textContent = input!.checked ? read : pending
    }

    input.addEventListener("change", update)
    update()
  })
</script>
