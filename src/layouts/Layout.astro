---
import "../styles/global.css"
import { ClientRouter } from "astro:transitions"
import { Font } from "astro:assets"

interface Props {
  title?: string
  description?: string
  image?: string
  canonical?: string
  alternateUrl?: string
  ogType?: "website" | "article" | "profile"
  publishedTime?: string
  modifiedTime?: string
  author?: string
  keywords?: string[]
  noindex?: boolean
}

const {
  title = "100cosas.dev | Consejos para Programadores",
  description = 'Una colección interactiva basada en "97 Things Every Programmer Should Know". Lee, aprende y marca tu progreso.',
  image = "/og-image.jpg",
  canonical,
  alternateUrl,
  ogType = "website",
  publishedTime,
  modifiedTime,
  author = "midudev",
  keywords = ["programación", "desarrollo", "software", "consejos", "clean code", "buenas prácticas"],
  noindex = false,
} = Astro.props

const lang = Astro.currentLocale || "es"

/** Normalize site paths so canonical/hreflang always match trailingSlash: 'always' */
function normalizeSitePath(path: string): string {
  if (!path || path === "/") return "/"
  const withLeading = path.startsWith("/") ? path : `/${path}`
  // Keep file-like paths (e.g. .json) without trailing slash
  if (/\.[a-z0-9]+$/i.test(withLeading)) return withLeading
  return withLeading.endsWith("/") ? withLeading : `${withLeading}/`
}

const canonicalPath = normalizeSitePath(canonical ?? Astro.url.pathname)
const canonicalURL = new URL(canonicalPath, Astro.site)
const fullImageURL = new URL(image, Astro.site).toString()
const skipToContentLabel =
  lang === "es" ? "Saltar al contenido principal" : "Skip to main content"
const darkThemeColor = "#0e0e0f"
const lightThemeColor = "#fbfaf6"

// Logic for hreflang — never invent alternate paths by prefixing locale;
// wrong guesses create 404s (e.g. /en/consejo/spanish-slug).
const localeCode = lang === "es" ? "es-ES" : "en-US"
const alternateLocaleCode = lang === "es" ? "en-US" : "es-ES"
const alternatePath = alternateUrl
  ? normalizeSitePath(alternateUrl)
  : lang === "es"
    ? "/en/"
    : "/"
const alternateURL = new URL(alternatePath, Astro.site)
// x-default: Spanish (default locale) version of this page when available
const xDefaultPath =
  lang === "es" ? canonicalPath : alternatePath === "/en/" ? "/" : alternatePath
const xDefaultURL = new URL(xDefaultPath, Astro.site)

// Determinar título SEO optimizado
const seoTitle = title.includes("100cosas.dev") ? title : `${title} | 100cosas.dev`

// JSON-LD dinámico según el tipo de página
const baseJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "100cosas.dev",
  "alternateName": "100 Cosas que Todo Programador Debería Saber",
  "url": "https://100cosas.dev",
  "inLanguage": ["es-ES", "en-US"],
  "description": lang === "es"
    ? "Consejos fundamentales para programadores y desarrolladores de software"
    : "Essential tips for programmers and software developers",
  "publisher": {
    "@type": "Organization",
    "name": "midudev",
    "url": "https://midu.dev",
    "logo": {
      "@type": "ImageObject",
      "url": "https://100cosas.dev/favicon.svg",
      "width": "512",
      "height": "512"
    },
    "sameAs": [
      "https://twitter.com/midudev",
      "https://github.com/midudev",
      "https://youtube.com/@midudev",
      "https://twitch.tv/midudev"
    ]
  }
}

const homeURL = new URL(lang === "es" ? "/" : "/en/", Astro.site)
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: lang === "es" ? "Inicio" : "Home", item: homeURL.href },
    { "@type": "ListItem", position: 2, name: title.split(" | ")[0], item: canonicalURL.href },
  ],
}
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        const STORAGE_KEY = "site-theme"
        const DARK_THEME_COLOR = "#0e0e0f"
        const LIGHT_THEME_COLOR = "#fbfaf6"
        const root = document.documentElement

        const getSystemTheme = () =>
          window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark"

        let theme = "dark"
        try {
          const storedTheme = localStorage.getItem(STORAGE_KEY)
          theme = storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : getSystemTheme()
        } catch {
          theme = getSystemTheme()
        }

        root.dataset.theme = theme
        root.style.colorScheme = theme

        const themeColorMeta = document.getElementById("theme-color-meta")
        if (themeColorMeta) {
          themeColorMeta.setAttribute(
            "content",
            theme === "light" ? LIGHT_THEME_COLOR : DARK_THEME_COLOR
          )
        }
      })()
    </script>

    <!-- Favicon y App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />

    <!-- SEO Meta Tags Básicos -->
    <title>{seoTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Indexación -->
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="googlebot" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="bingbot" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <!-- Temática y Color -->
    <meta name="theme-color" id="theme-color-meta" content={darkThemeColor} />
    <meta name="color-scheme" content="dark light" />
    <meta name="msapplication-TileColor" content={lightThemeColor} />

    <!-- Compatibilidad -->
    <meta name="format-detection" content="telephone=no" />

    <!-- i18n Hreflang -->
    {!noindex && (
      <>
        <link rel="alternate" hreflang={localeCode} href={canonicalURL} />
        <link rel="alternate" hreflang={alternateLocaleCode} href={alternateURL} />
        <link rel="alternate" hreflang="x-default" href={xDefaultURL} />
      </>
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="100cosas.dev" />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_ES"} />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === "article" && (
      <>
        <meta property="article:author" content={author} />
        <meta property="article:section" content="Programación" />
        {keywords.map((keyword) => (
          <meta property="article:tag" content={keyword} />
        ))}
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@midudev" />
    <meta name="twitter:creator" content="@midudev" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageURL} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:domain" content="100cosas.dev" />

    <!-- Font preload -->
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistPixel-Square-digits.woff2" as="font" type="font/woff2" crossorigin />
    <Font cssVariable="--font-newsreader" preload={[{ style: "normal", subset: "latin" }]} />

    <!-- JSON-LD Structured Data -->
    {canonicalURL.href === homeURL.href ? (
      <script type="application/ld+json" set:html={JSON.stringify(baseJsonLd)} />
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    )}

    <ClientRouter fallback="swap" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main-content">{skipToContentLabel}</a>
    <slot />
    <script>
      import { $ } from "../utils/dom"

      const listPaths = new Set(["/", "/es", "/es/", "/en", "/en/"])
      let activeTipId: string | undefined

      function markTip(root: ParentNode, id?: string) {
        $("[data-vt-active]", root)?.removeAttribute("data-vt-active")
        if (!id) return
        const escaped = CSS.escape(id)
        $(`.tip-card[data-id="${escaped}"], [data-tip-id="${escaped}"]`, root)
          ?.setAttribute("data-vt-active", "")
      }

      document.addEventListener("click", (event) => {
        const link = (event.target as Element | null)?.closest("a")
        if (!link || link.target || link.hasAttribute("download")) return

        activeTipId = link.closest<HTMLElement>(".tip-card")?.dataset.id
        if (!activeTipId && link.origin === location.origin && listPaths.has(link.pathname)) {
          activeTipId = $("[data-tip-id]")?.dataset.tipId
        }
        markTip(document, activeTipId)
      }, { capture: true })

      document.addEventListener("astro:before-swap", (event) => {
        const { newDocument } = event
        // Al volver mediante el historial no hay clic del que recuperar el consejo.
        const fromTip = $("[data-tip-id]")?.dataset.tipId
        const toTip = $("[data-tip-id]", newDocument)?.dataset.tipId
        markTip(newDocument, activeTipId ?? (toTip ? undefined : fromTip))
      })

      document.addEventListener("astro:page-load", () => {
        activeTipId = undefined
        markTip(document)
      })
    </script>
  </body>
</html>
